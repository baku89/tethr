{
	"name": "@tethr/doc",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently npm:dev:*",
		"dev:api": "typedoc --watch --preserveWatchOutput",
		"dev:doc": "vuepress dev docs",
		"build": "npm run build:api && vuepress build docs",
		"build:api": "typedoc",
		"typecheck": "vue-tsc --noEmit"
	},
	"dependencies": {
		"@baku89/pave": "^0.4.1",
		"js-yaml": "^4.1.0",
		"tweeq": "github:baku89/tweeq"
	},
	"devDependencies": {
		"@types/file-saver": "^2.0.7",
		"@types/node": "^20.14.2",
		"@types/wicg-file-system-access": "^2023.10.4",
		"@vue/tsconfig": "^0.5.1",
		"@vuepress/bundler-vite": "2.0.0-rc.26",
		"@vuepress/theme-default": "2.0.0-rc.123",
		"concurrently": "^9.0.0",
		"file-saver": "^2.0.5",
		"markdown-it-cjk-friendly": "^1.0.0",
		"pinia": "^3.0.1",
		"sass-embedded": "^1.83.0",
		"stylus": "^0.63.0",
		"typedoc": "^0.28.1",
		"typedoc-plugin-markdown": "^4.6.0",
		"vite-plugin-glsl": "^1.6.0",
		"vue": "^3.5.3",
		"vue-tsc": "^2.1.0",
		"vuepress": "2.0.0-rc.26"
	}
}
